# WalletConnect / Reown — https://cloud.reown.com
EXPO_PUBLIC_WC_PROJECT_ID=
# World ID — https://developer.world.org (public config; signer KEY stays server-side in secrets/)
EXPO_PUBLIC_WORLD_APP_ID=
EXPO_PUBLIC_WORLD_ACTION=policy-override-guard
EXPO_PUBLIC_WORLD_RP_ID=
# RPC endpoints (optional overrides; sane public defaults are baked in)
EXPO_PUBLIC_SEPOLIA_RPC=
EXPO_PUBLIC_MAINNET_RPC=
# ENS — the parent name NotWallet issues identity subnames under, on Sepolia.
# For claims to land on-chain, the signing account must control this parent
# (deploy NotWalletRegistrar, or point NODE at a name the account owns).
EXPO_PUBLIC_ENS_PARENT_NAME=notwallet.eth
EXPO_PUBLIC_ENS_PARENT_NODE=
# Optional: override ENS registry / resolver addresses on Sepolia
EXPO_PUBLIC_ENS_REGISTRY=
EXPO_PUBLIC_ENS_RESOLVER=
