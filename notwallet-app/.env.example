# WalletConnect / Reown — https://cloud.reown.com
EXPO_PUBLIC_WC_PROJECT_ID=
# World ID — https://developer.world.org (public config; signer KEY stays server-side in secrets/)
EXPO_PUBLIC_WORLD_APP_ID=
EXPO_PUBLIC_WORLD_ACTION=policy-override-guard
EXPO_PUBLIC_WORLD_RP_ID=
# Optional: override World proof verification. Leave BLANK to use World's hosted
# cloud endpoint (developer.worldcoin.org/api/v2/verify/<app_id>) — no server needed.
EXPO_PUBLIC_WORLD_VERIFY_URL=
# RPC endpoints (optional overrides; sane public defaults are baked in)
EXPO_PUBLIC_SEPOLIA_RPC=
EXPO_PUBLIC_MAINNET_RPC=
# ENS — ENSv2 Sepolia BETA (the hackathon deployment). Contract addresses are
# baked into src/ens.ts (ENSV2); only the parent name is configurable here.
# The parent must be registered AND own a subname registry before the app can
# issue identities. Run: npx ts-node scripts/ensv2-status.ts
EXPO_PUBLIC_ENS_PARENT_LABEL=notwallet
# Pin the parent's subname registry (skips on-chain discovery). Optional.
EXPO_PUBLIC_ENS_PARENT_REGISTRY=
# NotWalletRegistrar address (deploy via scripts/setup-registrar.ts (see README)). Until set,
# claiming names is disabled in-app with an honest message.
EXPO_PUBLIC_ENS_REGISTRAR=
